# FindShare local development environment
# Copy to .env and adjust. Never commit .env or real secrets.

# --- Application ---
APP_NAME=FindShare
APP_ENV=local
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-local-secret-at-least-32-chars

# --- Database ---
POSTGRES_USER=findshare
POSTGRES_PASSWORD=findshare_local_only
POSTGRES_DB=findshare
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://findshare:findshare_local_only@postgres:5432/findshare

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth (local JWT provider; Cognito is Phase 4) ---
AUTH_PROVIDER=local_jwt
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000

# --- Access control (Stage 1 / Phase 1 defaults: invitation-only) ---
REGISTRATION_MODE=invite_only
MAXIMUM_ACTIVE_USERS=10
REVIEWS_PER_USER=25
IMAGES_PER_REVIEW=5
MAXIMUM_IMAGE_SIZE_MB=10
REGISTRATION_ENABLED=true
IMAGE_UPLOADS_ENABLED=false
COMMENTS_ENABLED=false
PRICE_SUBMISSIONS_ENABLED=false
PUBLIC_COLLECTIONS_ENABLED=false
PLACEHOLDER_ADS_ENABLED=false
LIVE_ADVERTISING_ENABLED=false
ADVERTISING_PROVIDER=mock
MAINTENANCE_MODE=false

# --- Seeded local accounts (development only) ---
SEED_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=FindShareAdmin!dev
SEED_MODERATOR_EMAIL=moderator@example.com
SEED_MODERATOR_USERNAME=moderator
SEED_MODERATOR_PASSWORD=FindShareMod!dev
SEED_DEMO_EMAIL=demo.reviewer@example.com
SEED_DEMO_USERNAME=demo_reviewer
SEED_DEMO_PASSWORD=FindShareDemo!dev
SEED_INVITATION_CODE=FINDSHARE-DEV-INVITE

# --- Object storage (Phase 3; unused in Phase 1) ---
S3_ENDPOINT_URL=
S3_QUARANTINE_BUCKET=findshare-quarantine
S3_PUBLISHED_BUCKET=findshare-published
S3_DERIVATIVE_BUCKET=findshare-derivatives
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
PRESIGNED_UPLOAD_TTL_SECONDS=90

# --- Queues (Phase 3; unused in Phase 1) ---
SQS_ENDPOINT_URL=
SQS_MODERATION_QUEUE_URL=
SQS_IMAGE_QUEUE_URL=
SQS_NOTIFICATION_QUEUE_URL=

# --- Moderation adapters (Phase 3; unused in Phase 1) ---
MODERATION_MODE=mock
OBJECT_DETECTION_ADAPTER=mock
IMAGE_SAFETY_ADAPTER=mock
OCR_ADAPTER=mock
TEXT_CLASSIFIER_ADAPTER=mock

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=findshare-api

# --- Optional host port overrides (defaults match the Stage 1 URLs) ---
# WEB_HOST_PORT=3000
# API_HOST_PORT=8000
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# --- Budget guardrails (Phase 4+; dry-run only until explicitly enabled) ---
BUDGET_DRY_RUN=true
BUDGET_LIVE_ACTIONS_ENABLED=false
